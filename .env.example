# Variables SOLO de servidor (sin prefijo NEXT_PUBLIC_): nunca llegan al navegador.
# Supabase → Project Settings → API
SUPABASE_URL=https://wwhmyqncxxurrcwqudxw.supabase.co
# Publishable key (o "anon" en proyectos antiguos). Se usa junto con la sesión del usuario,
# así la base de datos sigue aplicando RLS. NO uses la secret / service_role key.
SUPABASE_KEY=sb_publishable_OWbGNBxWM74_pJLVD7uYNg_twra6nCQ

# Login solo con contraseña: correos de las dos cuentas creadas en Supabase → Authentication → Users.
# No se muestran en ninguna parte; la contraseña de cada cuenta define el rol al ingresar.
AUTH_ADMIN_EMAIL=admin@seguimiento.linktic.com
AUTH_LECTOR_EMAIL=lector@seguimiento.linktic.com
