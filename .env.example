# Todas las variables son SOLO de servidor (sin prefijo NEXT_PUBLIC_): nunca llegan al navegador.

# Supabase → Project Settings → API Keys
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Secret key (sb_secret_…) o service_role en proyectos antiguos. NO la publishable.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Secreto para firmar las sesiones (32+ caracteres aleatorios). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Los usuarios se guardan en la tabla seguimiento.usuarios (ver README).
