# Todas las variables son SOLO de servidor (sin prefijo NEXT_PUBLIC_): nunca llegan al navegador.

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Secret key (sb_secret_…) o service_role en proyectos antiguos. Solo en el servidor / Vercel.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Credenciales de ingreso (contraseñas de 12+ caracteres; recomendado 16+)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-contraseña-admin
LECTOR_USERNAME=lector
LECTOR_PASSWORD=cambia-esta-contraseña-lector

# Secreto para firmar las sesiones (32+ caracteres aleatorios). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
